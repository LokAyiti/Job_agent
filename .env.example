# Copy this file to .env and fill in your real values.
# DO NOT commit .env to git.

# Application paths
RESUME_DIR=resume
LOG_FILE=logs/applications.xlsx
SQLITE_DB=logs/job_queue.db
SCREENSHOT_DIR=logs/screenshots

# Your profile (used to pre-fill forms)
MY_NAME=Your Name
MY_EMAIL=your.email@example.com
MY_PHONE=+1-555-123-4567
MY_LINKEDIN=https://linkedin.com/in/yourprofile

# Login credentials for first-time account creation on ATS platforms
# (Workday, iCIMS, and others that require a candidate account).
# These are encrypted at rest with Fernet. Set CREDENTIAL_MASTER_KEY for
# production; otherwise a local key file is generated automatically.
LOGIN_EMAIL=your.email@example.com
LOGIN_PASSWORD=yourSecurePassword123!

# 2Captcha API key (optional — leave blank to skip automatic CAPTCHA solving)
# Sign up at https://2captcha.com to obtain a key.
# NEVER put a real key in this sample file; copy this file to .env and set it there.
2CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT_SECONDS=120

# Google service account credentials (optional — leave blank to skip Google sync)
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service-account.json
GOOGLE_SHEET_ID=1xx...yy
GOOGLE_DRIVE_FOLDER_ID=1zz...ww

# Gmail integration (optional — OAuth2 or service account with domain-wide delegation)
GMAIL_SENDER_EMAIL=your.email@example.com
GMAIL_CREDENTIALS_JSON=secrets/gmail-credentials.json

# Outlook / Microsoft 365 integration (optional — OAuth2 via Microsoft Graph)
# Register an app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Required delegated permissions: Mail.Read, Mail.ReadWrite, Mail.Send
OUTLOOK_CLIENT_ID=your-app-client-id
OUTLOOK_USE_DEVICE_CODE=true
OUTLOOK_AUTHORITY=https://login.microsoftonline.com/common

# Credential encryption (optional — leave blank to auto-generate a local key)
# Provide a base64-encoded Fernet key for production. The key file is created
# automatically if CREDENTIAL_MASTER_KEY is not set; back it up securely.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_FILE=.credential_key

# Proxy / anti-detection (optional — comma-separated list of proxies)
# Format: server OR user:pass@server:port
PROXY_LIST=
USE_STEALTH=true
BROWSER_HEADLESS=true

# Human-like pacing (seconds)
HUMANIZER_MIN_DELAY=0.15
HUMANIZER_MAX_DELAY=0.55
TYPING_DELAY_MIN=0.03
TYPING_DELAY_MAX=0.12
DELAY_BETWEEN_JOBS_SECONDS=10
JITTER_BETWEEN_JOBS=true

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false
AGENT_LOG_FILE=logs/job_agent.log
JSON_LOGS=false

# Base resume library, fabrication tolerance, and profile JSON
PROFILE_JSON=profile.json
BASE_RESUME_DIR=base resume
BASE_RESUME_TEMPLATE=base resume/Resume AI Engineer.docx
BASE_COVER_LETTER_DIR=base cover letter
FABRICATION_TOLERANCE=moderate

# LLM fit scoring
MIN_FIT_SCORE=60
LLM_FIT_SCORE_WEIGHT=0.7

# Trusted platforms — comma-separated adapter names (e.g., governmentjobs,greenhouse)
# A platform is added here automatically after AUTO_APPROVE_AFTER_SUCCESSES approved/submitted jobs.
TRUSTED_PLATFORMS=
AUTO_APPROVE_AFTER_SUCCESSES=3

# Safety switches
ENABLE_AUTO_SUBMIT=false
HUMAN_IN_THE_LOOP=true

# Rate limiting / retries
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=120.0
